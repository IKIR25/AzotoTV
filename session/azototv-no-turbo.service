# Optional: /etc/systemd/system/azototv-no-turbo.service, with the user AzotoTV
# runs as in place of @USER@. For a machine that gets hot and loud (a laptop
# under the TV): CPU turbo off by default, and its switch made writable for
# that user's group, so AzotoTV turns it on only while a game runs
# (src-tauri/src/system.rs). Works with intel_pstate's switch or cpufreq's boost.
[Unit]
Description=AzotoTV: keep CPU turbo off outside games
After=sysinit.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'p=/sys/devices/system/cpu; if [ -e $p/intel_pstate/no_turbo ]; then f=$p/intel_pstate/no_turbo; v=1; else f=$p/cpufreq/boost; v=0; fi; echo $v > $f && chgrp @USER@ $f && chmod 664 $f'
ExecStop=/bin/sh -c 'p=/sys/devices/system/cpu; if [ -e $p/intel_pstate/no_turbo ]; then echo 0 > $p/intel_pstate/no_turbo; else echo 1 > $p/cpufreq/boost; fi'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
