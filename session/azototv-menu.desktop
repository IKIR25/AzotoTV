# The desktop's menu entry: install.sh puts it in ~/.local/share/applications
# with the user's home in place of @HOME@.
[Desktop Entry]
Type=Application
Name=AzotoTV
Comment=Back to AzotoTV (closes the desktop)
Comment[it]=Torna a AzotoTV (chiude il desktop)
Exec=@HOME@/azototv/tv-mode.sh
Icon=video-television
Categories=AudioVideo;
