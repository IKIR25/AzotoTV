# ~/.config/azototv/session.env: read by session.sh before KWin starts.
# Only needed when KWin should not choose its GPU by itself.

# A laptop with an integrated GPU and a second one driving the TV: composite on
# the integrated one (first = primary), so the menus don't keep the other awake.
# `ls -l /dev/dri/by-path/` shows the PCI paths of this machine's cards.
#export KWIN_DRM_DEVICES=$(readlink -f /dev/dri/by-path/pci-0000:00:02.0-card):$(readlink -f /dev/dri/by-path/pci-0000:01:00.0-card)
